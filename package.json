{
  "name": "akim-simulator",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src/app src/components src/data src/types/index.ts src/lib/api app/*.tsx app/simulation app/results",
    "test:e2e": "playwright test",
    "test:map": "playwright test -c playwright.map.config.ts",
    "predev": "node scripts/prepare-map-assets.mjs",
    "prebuild": "node scripts/prepare-map-assets.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.47.0",
    "maplibre-gl": "^6.11.1",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
